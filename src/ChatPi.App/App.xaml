<Application x:Class="ChatPi.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#11141A" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1A1F29" />
    <SolidColorBrush x:Key="TextBrush" Color="#F2F3F7" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A5ADBC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#BCE3CB" />
    <Style TargetType="Window">
      <Setter Property="Background" Value="{StaticResource PageBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontFamily" Value="Yu Gothic UI, Segoe UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="UseLayoutRounding" Value="True" />
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#303846" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.6" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.35" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Foreground" Value="#11141A" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource PanelBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="#465061" />
      <Setter Property="Padding" Value="8,6" />
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>
    <BooleanToVisibilityConverter x:Key="BoolVisibility" />
  </Application.Resources>
</Application>
