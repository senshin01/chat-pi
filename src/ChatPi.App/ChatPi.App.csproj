<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>ChatPi</AssemblyName>
    <RootNamespace>ChatPi.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/ChatPi.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Version>0.4.1</Version>
    <Description>Simple WASAPI and ASIO music player with EQ and high-quality PCM upsampling</Description>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets/FileIcons/*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <ProjectReference Include="../ChatPi.Core/ChatPi.Core.csproj" />
    <PackageReference Include="NAudio" Version="2.3.0" />
  </ItemGroup>
</Project>
