<Window x:Class="ChatPi.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Pi — 設定" Width="500" Height="650" MinWidth="440" MinHeight="580" ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="26">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="出力設定" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock Text="シンプルに、元のサンプルレートで。" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,24" />
        <TextBlock Text="出力モード" Margin="0,0,0,7" />
        <ComboBox x:Name="ModeBox" SelectionChanged="OnModeChanged" SelectedValuePath="Tag" AutomationProperties.Name="出力モード">
          <ComboBoxItem Content="WASAPI（排他）" Tag="WasapiExclusive" />
          <ComboBoxItem Content="WASAPI（共有）" Tag="WasapiShared" />
          <ComboBoxItem Content="ASIO" Tag="Asio" />
        </ComboBox>
        <StackPanel x:Name="WasapiPanel" Margin="0,18,0,0">
          <TextBlock Text="再生デバイス" Margin="0,0,0,7" />
          <ComboBox x:Name="DeviceBox" DisplayMemberPath="Name" AutomationProperties.Name="WASAPI 再生デバイス" />
          <TextBlock Text="バッファ (ms) · 20〜500" Margin="0,16,0,7" />
          <TextBox x:Name="LatencyBox" AutomationProperties.Name="WASAPI バッファ (ms)" />
        </StackPanel>
        <StackPanel x:Name="AsioPanel" Margin="0,18,0,0" Visibility="Collapsed">
          <TextBlock Text="ASIO ドライバー（64 bit）" Margin="0,0,0,7" />
          <ComboBox x:Name="DriverBox" AutomationProperties.Name="ASIO ドライバー" />
          <TextBlock Text="出力開始チャンネル · 1 = チャンネル 1 / 2" Margin="0,16,0,7" />
          <TextBox x:Name="ChannelBox" AutomationProperties.Name="ASIO 出力開始チャンネル" />
          <TextBlock Text="バッファサイズはメーカーの ASIO コントロールパネルで設定してください。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0" />
        </StackPanel>
        <TextBlock x:Name="ModeHelp" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,18,0,0" />
        <TextBlock x:Name="DeviceNotice" TextWrapping="Wrap" Foreground="#E9CA95" FontSize="12" Margin="0,10,0,0" />
        <Border BorderBrush="#303846" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0">
          <StackPanel>
            <TextBlock Text="ファイルの既定アプリ" FontWeight="SemiBold" />
            <TextBlock Text="Chat Pi を候補に登録した後、Windows の設定で MP3 / WAV の既定アプリに選択できます。" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,7,0,12" />
            <Button Content="登録して Windows の設定を開く" Click="OnRegister" HorizontalAlignment="Left" />
            <Button Content="Chat Pi の登録を解除" Click="OnUnregister" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" />
            <TextBlock x:Name="AssociationNotice" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0" />
          </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#FFBFC8" Margin="0,14,0,0" />
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="キャンセル" IsCancel="True" Margin="0,0,10,0" />
      <Button Content="保存" Click="OnSave" IsDefault="True" Background="{StaticResource AccentBrush}" Foreground="#15221A" />
    </StackPanel>
  </Grid>
</Window>
