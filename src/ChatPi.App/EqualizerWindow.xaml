<Window x:Class="ChatPi.App.EqualizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PlayerWindowStyle}" Title="Chat Pi — 15バンド EQ"
        Width="890" Height="460" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="15バンド EQ" FontSize="22" FontWeight="SemiBold" />
      <TextBlock x:Name="RateNotice" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,7,0,16" TextWrapping="Wrap" />
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="BandsControl">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Width="50" Margin="2,0" IsEnabled="{Binding Active}" Opacity="{Binding Opacity}">
              <TextBlock Text="{Binding GainDb, StringFormat={}{0:+0.0;-0.0;0.0}}" FontSize="11" HorizontalAlignment="Center" />
              <Slider Value="{Binding GainDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-12" Maximum="12"
                      Orientation="Vertical" Height="150" Margin="0,10" TickFrequency="0.5" IsSnapToTickEnabled="True"
                      AutomationProperties.Name="{Binding Label}" ToolTip="{Binding GainDb, StringFormat={}{0:0.0} dB}" />
              <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,18,0,0">
      <Button Content="フラットに戻す" Click="OnReset" HorizontalAlignment="Left" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="キャンセル" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="決定" Click="OnAccept" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
