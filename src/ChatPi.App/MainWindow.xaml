<Window x:Class="ChatPi.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Pi" Width="650" Height="540" MinWidth="540" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop"
        PreviewKeyDown="OnWindowKeyDown">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <Grid Margin="28,22,28,20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="chat pi" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text=" / MUSIC PLAYER" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
      </StackPanel>
      <Button HorizontalAlignment="Right" Click="OnSettings" ToolTip="設定" AutomationProperties.Name="設定" Padding="12,10">
        <Path Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" Width="17" Height="17" Stretch="Uniform"
              Data="M 9,0 L 9,4 M 9,14 L 9,18 M 0,9 L 4,9 M 14,9 L 18,9 M 2.6,2.6 L 5.3,5.3 M 12.7,12.7 L 15.4,15.4 M 2.6,15.4 L 5.3,12.7 M 12.7,5.3 L 15.4,2.6 M 14,9 A 5,5 0 1 1 4,9 A 5,5 0 1 1 14,9" />
      </Button>
    </Grid>

    <Grid Grid.Row="1" Margin="0,28,0,25" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Height="180" CornerRadius="12" Background="{StaticResource PanelBrush}" ClipToBounds="True">
        <Grid>
          <Image Source="{Binding Artwork}" Stretch="UniformToFill" Visibility="{Binding HasArtwork, Converter={StaticResource BoolVisibility}}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowPlaceholder, Converter={StaticResource BoolVisibility}}">
            <Path Width="48" Height="54" Stretch="Uniform" Stroke="#667D72" StrokeThickness="2.5"
                  Data="M 15,42 L 15,8 L 45,2 L 45,36 M 15,17 L 45,11 M 15,42 A 7,5 0 1 1 1,42 A 7,5 0 1 1 15,42 M 45,36 A 7,5 0 1 1 31,36 A 7,5 0 1 1 45,36" />
            <TextBlock Text="JUST LISTEN" Foreground="#667D72" FontSize="10" Margin="0,18,0,0" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Border>
      <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Album}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" ToolTip="{Binding Album}" />
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="100" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}" />
        <TextBlock Text="{Binding Artist}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,12,0,0" ToolTip="{Binding Artist}" />
        <TextBlock Text="{Binding FormatText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,20,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="2">
      <Slider x:Name="ProgressSlider" Value="{Binding PositionSeconds, Mode=OneWay}" Maximum="{Binding DurationSeconds}"
              Minimum="0" IsEnabled="{Binding CanSeek}" AutomationProperties.Name="再生位置"
              PreviewMouseLeftButtonDown="OnSeekStart" PreviewMouseLeftButtonUp="OnSeekEnd"
              PreviewKeyDown="OnSeekKeyDown" PreviewKeyUp="OnSeekKeyUp" />
      <Grid Margin="0,4,0,18">
        <TextBlock Text="{Binding PositionText}" Foreground="{StaticResource MutedBrush}" FontSize="11" />
        <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right" />
      </Grid>
      <Grid>
        <Button Click="OnOpen" HorizontalAlignment="Left" Content="ファイルを開く" ToolTip="Ctrl+O" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Click="OnStop" IsEnabled="{Binding HasTrack}" ToolTip="停止 (Esc)" AutomationProperties.Name="停止" Margin="0,0,10,0" Padding="16,12">
            <Rectangle Fill="{StaticResource TextBrush}" Width="12" Height="12" RadiusX="1" RadiusY="1" />
          </Button>
          <Button Click="OnTogglePlay" IsEnabled="{Binding HasTrack}" ToolTip="再生／一時停止 (Space)" AutomationProperties.Name="{Binding PlayLabel}"
                  Background="{StaticResource AccentBrush}" Foreground="#15221A" BorderBrush="{StaticResource AccentBrush}" Width="120">
            <StackPanel Orientation="Horizontal">
              <Path Data="M 0,0 L 0,12 L 10,6 Z" Fill="#15221A" Width="10" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"
                    Visibility="{Binding IsNotPlaying, Converter={StaticResource BoolVisibility}}" />
              <Path Data="M 0,0 L 3,0 L 3,12 L 0,12 Z M 7,0 L 10,0 L 10,12 L 7,12 Z" Fill="#15221A" Width="10" Height="12" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0"
                    Visibility="{Binding IsPlaying, Converter={StaticResource BoolVisibility}}" />
              <TextBlock Text="{Binding PlayLabel}" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </StackPanel>

    <Border Grid.Row="3" Background="#332125" BorderBrush="#674148" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,14,0,0"
            Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
      <ScrollViewer MaxHeight="86" VerticalScrollBarVisibility="Auto">
        <TextBlock Text="{Binding Error}" Foreground="#FFBFC8" FontSize="12" TextWrapping="Wrap" />
      </ScrollViewer>
    </Border>

    <Border Grid.Row="4" BorderBrush="#29303B" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding OutputModeText}" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" />
          <TextBlock Text="{Binding DeviceText}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,16,0" ToolTip="{Binding DeviceText}" />
          <TextBlock Text="{Binding OutputText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Top" />
      </Grid>
    </Border>
  </Grid>
  </ScrollViewer>
</Window>
